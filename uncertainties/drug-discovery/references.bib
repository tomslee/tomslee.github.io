  author = {Romero, Sebasti{\'a}n V. and Cadavid, Alejandro Gomez and Nika{\v c}evi{\'c}, Pavle and Solano, Enrique and Hegade, Narendra N. and {Lopez-Ruiz}, Miguel Angel and Girotto, Claudio and Yamada, Masako and Barkoutsos, Panagiotis Kl and Kaushik, Ananth and Roetteler, Martin},
