@misc{gillQuantumComputingVision2024,
  title = {Quantum {{Computing}}: {{Vision}} and {{Challenges}}},
  shorttitle = {Quantum {{Computing}}},
  author = {Gill, Sukhpal Singh and Cetinkaya, Oktay and Marrone, Stefano and Claudino, Daniel and Haunschild, David and Schlote, Leon and Wu, Huaming and Ottaviani, Carlo and Liu, Xiaoyuan and Machupalli, Sree Pragna and Kaur, Kamalpreet and Arora, Priyansh and Liu, Ji and Shamshad, Salman and Farouk, Ahmed and Song, Houbing Herbert and Uhlig, Steve and Ramamohanarao, Kotagiri},
  year = 2024,
