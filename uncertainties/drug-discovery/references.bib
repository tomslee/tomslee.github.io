@article{waintalQuantumHouseCards2024,
  title = {The Quantum House of Cards},
  author = {Waintal, Xavier},
  year = 2024,
  month = jan,
  journal = {Proceedings of the National Academy of Sciences of the United States of America},
  volume = {121},
  number = {1},
