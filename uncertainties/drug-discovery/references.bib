  author = {Beige, Almut and Predojevi{\'c}, Ana and Metelmann, Anja and Sanpera, Anna and Macchiavello, Chiara and Koch, Christiane P. and Silberhorn, Christine and Toninelli, Costanza and Bru{\ss}, Dagmar and Ercolessi, Elisa and Paladino, Elisabetta and Ferlaino, Francesca and Ferrini, Giulia and Platero, Gloria and Fuentes, Ivette and Nemoto, Kae and Tarruell, Leticia and Bondani, Maria and Chiofalo, Marilu and Pons, Marisa and D'Angelo, Milena and Murao, Mio and Fabbri, Nicole and Verrucchi, Paola and {Senellart-Mardon}, Pascale and Citro, Roberta and Zambrini, Roberta and {Gonz{\'a}lez-F{\'e}rez}, Rosario and Maniscalco, Sabrina and Huelga, Susana and Mehlst{\"a}ubler, Tanja and Parigi, Valentina and Ahufinger, Ver{\'o}nica},
